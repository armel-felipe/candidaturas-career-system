{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "share": "disabled",
  "instructions": [
    "AGENTS.md"
  ],
  "permission": {
    "*": "allow",
    "external_directory": "ask",
    "doom_loop": "ask",
    "read": {
      "*": "allow",
      ".env": "deny",
      ".env.*": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      ".env.example": "allow"
    },
    "bash": {
      "*": "allow",
      "rm *": "deny",
      "del *": "deny",
      "rmdir *": "deny",
      "Remove-Item *": "ask",
      "git reset *": "deny",
      "git clean *": "deny",
      "git checkout -- *": "deny"
    },
    "skill": "allow",
    "webfetch": "ask"
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "outputs/_tmp/**",
      ".tmp_cv*/**",
      ".git/**"
    ]
  }
}
